# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=retinopathy_classifier_experiment
MLFLOW_MODEL_NAME=retinopathy_classifier

# MLflow S3 / MinIO backend credentials (if using remote artifact store)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# Prefect Configuration
PREFECT_API_URL=http://127.0.0.1:4200/api
PREFECT_LOGGING_LEVEL=INFO

# DVC Remote Storage (Optional)
# DVC_REMOTE_URL=s3://my-mlops-dvc-bucket/data

# Hardware and Environment
CUDA_VISIBLE_DEVICES=0
PYTHONPATH=.
